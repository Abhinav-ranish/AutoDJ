{
  "productName": "AutoDJ",
  "version": "0.1.0",
  "identifier": "com.autodj.app",
  "build": {
    "beforeDevCommand": "cd $(git rev-parse --show-toplevel)/ui && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd $(git rev-parse --show-toplevel)/ui && npm run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoDJ",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}