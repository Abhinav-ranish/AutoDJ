# AutoDJ Environment Configuration

# -----------------
# AI Conductor
# -----------------
# Provider: "gemini", "groq", or "ollama"
AI_PROVIDER=gemini

# Gemini — drop your API key here to skip UI configuration
GEMINI_API_KEY=AIzaSy...

# Groq — get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Ollama — local inference, no API key needed
# Install: https://ollama.com  |  Pull model: ollama pull qwen2.5:7b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_ENDPOINT=http://localhost:11434/v1
